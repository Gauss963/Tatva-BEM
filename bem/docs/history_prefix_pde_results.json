    "driver_source": "\"\"\"Check optional prefix CLI and actual saved-kernel sliding/initialized AD.\"\"\"\nimport hashlib,json,os,subprocess,time\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nROOT=Path('/Users/b09501028/Downloads/bem2d.jl/Tatva-BEM')\nOUT=ROOT/'bem/outputs/prefix-cli-control-20261103-v1'\nPYTHON='/opt/homebrew/Caskroom/miniconda/base/envs/tatva/bin/python'\nKERNEL=ROOT/'bem/outputs/trace-policy-coarse-kernel-20261101-v1'\nOUT.mkdir()\ndef sha(p):\n h=hashlib.sha256()\n with Path(p).open('rb')as f:\n  for b in iter(lambda:f.read(4*1024**2),b''):h.update(b)\n return h.hexdigest()\ndef write(name,data):(OUT/name).write_text(json.dumps(data,indent=2,allow_nan=False)+'\\n')\ndef now():return datetime.now(timezone.utc).isoformat()\noriginal=json.loads((ROOT/'bem/outputs/resumed-radau-event-study-20261103/frozen_inputs.json').read_text())\npaths=[*list((ROOT/'bem/tools').glob('*.py')),ROOT/'bem/tests/test_prefix_cached_cli.py',ROOT/'bem/tests/test_history_cache.py',Path(__file__)]\nfrozen={**original,**{str(p.resolve()):sha(p)for p in paths}}\nwrite('frozen_inputs.json',frozen)\narchive=OUT/'source-archive';archive.mkdir()\nfor p in paths:\n if p.name in ['simulate_prefix_cached_radau.py','check_prefix_cached_radau.py','history_prefix_cache.py','test_prefix_cached_cli.py','test_history_cache.py',Path(__file__).name]:\n  (archive/p.name).write_bytes(p.read_bytes())\ndef verify():\n changed=[p for p,h in frozen.items()if sha(p)!=h]\n if changed:raise RuntimeError('Frozen source changed: '+repr(changed))\n metadata=json.loads(Path('/Volumes/Gauss-T7/Tatva-BEM-cache/fresh-radau2us-graded-q12-full45-20261028/summary.json').read_text())\n current={p.name:sha(p)for p in sorted((ROOT/'bem/src/finiteblock_bem').glob('*.py'))}\n if current!=metadata['environment']['source_sha256']:raise RuntimeError('Complete package fingerprint changed')\nenv={**os.environ,'PYTHONPATH':str(ROOT/'bem/src'),'PYTHONDONTWRITEBYTECODE':'1','OPENBLAS_NUM_THREADS':'1','OMP_NUM_THREADS':'1','MKL_NUM_THREADS':'1','VECLIB_MAXIMUM_THREADS':'1','TF_NUM_INTRAOP_THREADS':'1','TF_NUM_INTEROP_THREADS':'1','FDBEM_CORES':'1','JAX_ENABLE_X64':'true','XLA_FLAGS':'--xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1'}\nenv.update(json.loads((KERNEL/'jax-backend-context.json').read_text())['runtime']['thread_environment'])\nchild=quota=None;begun=time.perf_counter();stages=[]\ndef execute(name,command):\n global child,quota\n verify();started=time.perf_counter();utc=now()\n with(OUT/(name+'.log')).open('x')as log,(OUT/(name+'-quota.log')).open('x')as qlog:\n  child=subprocess.Popen(command,cwd=ROOT,env=env,stdout=log,stderr=subprocess.STDOUT,stdin=subprocess.DEVNULL)\n  anchor=subprocess.check_output(['ps','-p',str(child.pid),'-o','lstart='],text=True).strip()\n  quota=subprocess.Popen([PYTHON,'-B',str(ROOT/'bem/tools/limit_process_cpu.py'),'--pid',str(child.pid),'--expected-start',anchor,'--expected-command-fragment',command[5] if '-m' in command else command[2],'--cores','.1','--interval','.1','--output',str(OUT/(name+'-cpu-quota'))],cwd=ROOT,env=env,stdout=qlog,stderr=subprocess.STDOUT)\n  write('status.json',dict(phase=name,owner_pid=os.getpid(),child_pid=child.pid,controller_pid=quota.pid,child_start=anchor,utc=utc,command=command,additional_average_cpu_budget=.1,existing_event_budget=3.85,stages=stages,full_original_goal_achieved=False))\n  while child.poll()is None:\n   if quota.poll()is not None:raise RuntimeError('CPU quota ended while numerical control remains live')\n   verify();time.sleep(1)\n  code=child.wait()\n  if quota.poll()is not None and quota.returncode != 0:raise RuntimeError('Quota process failed; preserve numerical outputs but reject control')\n  if not (OUT/(name+'-cpu-quota/status.json')).is_file():raise RuntimeError('Quota never initialized; reject control')\n  if quota.poll()is None:quota.terminate();quota.wait(timeout=10)\n stages.append(dict(name=name,exit_code=code,seconds=time.perf_counter()-started,utc_start=utc,utc_end=now(),command=command))\n child=quota=None\n verify()\n if code:raise RuntimeError(name+' failed; inspect saved log')\ntry:\n common=[str(KERNEL),'--restart-seed',str(ROOT/'bem/src/finiteblock_bem/resources/data/ev16_restart_float64.npz'),'--static-initialization','fem-body-active-set','--segment-substeps','8','16','--contact-root-recovery','--kinetic-root-seed','--fft-cache-mb','8','--fft-rows','4','--max-memory-mb','8192']\n for name,tool in [('original','simulate_compact_radau.py'),('cached','simulate_prefix_cached_radau.py')]:\n  command=[PYTHON,'-B',str(ROOT/'bem/tools'/tool),*common,'--output',str(OUT/name)]\n  if name=='cached':command+=['--history-prefix-cache-mb','144','--history-prefix-lags','32']\n  execute(name,command)\n import zipfile\n comparisons={}\n for name in ['initial_lift.npz','trajectory.npz','stages.npz']:\n  with zipfile.ZipFile(OUT/'original'/name)as first,zipfile.ZipFile(OUT/'cached'/name)as second:\n   if first.namelist()!=second.namelist():raise RuntimeError('Saved CLI array fields differ')\n   comparisons[name]={key:hashlib.sha256(first.read(key)).hexdigest()==hashlib.sha256(second.read(key)).hexdigest() for key in first.namelist()}\n if not all(all(values.values())for values in comparisons.values()):raise RuntimeError('Actual CLI arrays differ; preserve all outputs and inspect')\n policy=json.loads((OUT/'cached/history-prefix-policy.json').read_text())\n if policy['status']!='completed_original_simulation_with_prefix_cache' or policy['cache']['cached_lags']!=32:raise RuntimeError('CLI policy was not adopted')\n write('summary.json',dict(status='passed_actual_original_and_cached_complete_coarse_cli',stages=stages,seconds=time.perf_counter()-begun,array_member_bitwise_equality=comparisons,policy=policy,all_frozen_sources_unchanged=True,complete_original_package_fingerprint_unchanged=True,original_full_event_not_paused_or_modified=True,full_original_goal_achieved=False,isolated_speed_comparison=False))\n write('status.json',dict(phase='completed',owner_pid=os.getpid(),stages=stages,seconds=time.perf_counter()-begun,full_original_goal_achieved=False))\nexcept BaseException as error:\n if quota is not None and quota.poll()is None:quota.terminate();quota.wait(timeout=10)\n if child is not None and child.poll()is None:child.terminate();child.wait(timeout=10)\n write('failure.json',dict(error=repr(error),stages=stages,seconds=time.perf_counter()-begun))\n write('status.json',dict(phase='attention_required',owner_pid=os.getpid(),stages=stages,error=repr(error),seconds=time.perf_counter()-begun,full_original_goal_achieved=False))\n raise\n",
